# AdvCRM Bot — configuração de ambiente (Fase 1)
# Copie para .env e ajuste. Nunca commit secrets.

APP_NAME=advcrm-bot
APP_ENV=local
LOG_LEVEL=INFO

# Limiares de confiança (política determinística)
CONFIDENCE_HIGH_THRESHOLD=0.80
CONFIDENCE_MEDIUM_THRESHOLD=0.60

# Limite máximo de perguntas automatizadas por triagem
MAX_AUTOMATED_QUESTIONS=5

# Versão da taxonomia esperada
TAXONOMY_VERSION=legal_subjects.v1

# Fail-closed em contratos inválidos (sempre true em produção)
FAIL_CLOSED=true

# Host/porta do serviço
HOST=0.0.0.0
PORT=8080
