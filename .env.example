# AdvCRM Bot — configuração de ambiente
# Copie para .env e ajuste. Nunca commit secrets.

APP_NAME=advcrm-bot
APP_ENV=local
LOG_LEVEL=INFO

# Limiares de confiança (política determinística)
CONFIDENCE_HIGH_THRESHOLD=0.80
CONFIDENCE_MEDIUM_THRESHOLD=0.60

# Limite máximo de perguntas automatizadas por triagem
MAX_AUTOMATED_QUESTIONS=5

# Versão da taxonomia esperada
TAXONOMY_VERSION=legal_subjects.v1

# Fail-closed em contratos inválidos (sempre true em produção)
FAIL_CLOSED=true

# Host/porta do serviço
HOST=0.0.0.0
PORT=8080

# --- AdvCRM AI runtime (Fase 1.1.1 — generate/structured) ---
# Desabilitado por padrão. Não inclua credenciais reais neste arquivo.
AI_RUNTIME_ENABLED=false
AI_RUNTIME_REQUIRED=false
# Ex.: http://10.10.10.170:18100
AI_RUNTIME_BASE_URL=http://localhost:8001
AI_RUNTIME_STRUCTURED_GENERATION_PATH=/internal/v1/generate/structured
# Credencial S2S (ADVCRM_AI_INTERNAL_TOKEN no AdvCRM AI). Nunca a chave do llama.cpp.
AI_RUNTIME_API_KEY=
# UUID da organização confiável (CLI/runtime). Não derive de tenant_id sem mapeamento.
AI_RUNTIME_ORGANIZATION_ID=
# Opcional — X-AdvCRM-User-Id (auditoria)
AI_RUNTIME_USER_ID=
# Modelo é escolhido pelo runtime; deixe vazio. O bot registra o model retornado.
AI_RUNTIME_MODEL=
AI_RUNTIME_TIMEOUT_SECONDS=60
AI_RUNTIME_CONNECT_TIMEOUT_SECONDS=5
AI_RUNTIME_MAX_RETRIES=2
AI_RUNTIME_RETRY_AFTER_CAP_SECONDS=5
AI_RUNTIME_TEMPERATURE=0
# Proposta inicial para teste sintético (limite do servidor: 1..2048). Sem evidência live de suficiência.
AI_RUNTIME_MAX_TOKENS=2048
AI_RUNTIME_VERIFY_TLS=true
AI_RUNTIME_PROMPT_VERSION=triage_prompts.v1
# Readiness do AdvCRM AI. /health é só liveness e NÃO prova disponibilidade do modelo.
# Obrigatório se AI_RUNTIME_REQUIRED=true. Garantia de /ready depende da config do AdvCRM AI.
AI_RUNTIME_READY_PATH=/ready
AI_CONTEXT_MAX_CHARS=50000
# Contrato do extrator (schema JSON inline no runtime). v2 = ocorrências + cues.
# AI_SAFETY_SIGNALS_SCHEMA_VERSION=safety_signals.v2
