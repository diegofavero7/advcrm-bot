# AdvCRM Bot — configuração de ambiente
# Copie para .env e ajuste. Nunca commit secrets.

APP_NAME=advcrm-bot
APP_ENV=local
LOG_LEVEL=INFO

# Limiares de confiança (política determinística)
CONFIDENCE_HIGH_THRESHOLD=0.80
CONFIDENCE_MEDIUM_THRESHOLD=0.60

# Limite máximo de perguntas automatizadas por triagem
MAX_AUTOMATED_QUESTIONS=5

# Versão da taxonomia esperada
TAXONOMY_VERSION=legal_subjects.v1

# Fail-closed em contratos inválidos (sempre true em produção)
FAIL_CLOSED=true

# Host/porta do serviço
HOST=0.0.0.0
PORT=8080

# --- AdvCRM AI runtime (Fase 1.1) ---
# Desabilitado por padrão. Não inclua credenciais reais neste arquivo.
AI_RUNTIME_ENABLED=false
AI_RUNTIME_REQUIRED=false
AI_RUNTIME_BASE_URL=http://localhost:8001
AI_RUNTIME_CHAT_COMPLETIONS_PATH=/v1/chat/completions
AI_RUNTIME_MODEL=
AI_RUNTIME_API_KEY=
AI_RUNTIME_TIMEOUT_SECONDS=60
AI_RUNTIME_CONNECT_TIMEOUT_SECONDS=5
AI_RUNTIME_MAX_RETRIES=2
AI_RUNTIME_RETRY_AFTER_CAP_SECONDS=5
AI_RUNTIME_TEMPERATURE=0
AI_RUNTIME_MAX_TOKENS=
AI_RUNTIME_VERIFY_TLS=true
AI_RUNTIME_PROMPT_VERSION=triage_prompts.v1
# Obrigatório somente se AI_RUNTIME_REQUIRED=true
AI_RUNTIME_HEALTH_PATH=
AI_CONTEXT_MAX_CHARS=50000
